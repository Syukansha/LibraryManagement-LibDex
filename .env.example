# Template for local development config (12-factor III).
# Copy to .env (gitignored) and adjust the values:
#   copy .env.example .env
# The Spring app imports .env as a local fallback (spring.config.import), and
# docker compose reads it for variable substitution. In real deployments these
# same keys arrive as OS environment variables instead - the app code and the
# committed files never contain them.
DB_URL=jdbc:postgresql://localhost:5432/library_db
DB_USER=library_admin
DB_PASSWORD=change-me
# JWT signing key (HS256): at least 32 characters
JWT_SECRET=replace-with-at-least-32-random-characters
